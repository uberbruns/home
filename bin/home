#!/usr/bin/env bash
# Launch the home CLI with an interpreter that meets its Python 3.11+ requirement.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

for python in python3 /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
  # Skip candidates that are absent or too old for tomllib
  command -v "$python" >/dev/null 2>&1 || continue
  "$python" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null || continue

  exec "$python" "$SCRIPT_DIR/home_cli.py" "$@"
done

echo "home: no Python 3.11 or newer found" >&2
exit 1
